---
// Shows a Google AdSense unit ONLY when config.ads.enabled is true and a slot ID is set.
import { config } from '../config.mjs';
const { slot } = Astro.props; // 'top' | 'end' | 'home'
const id = config.ads.slots[slot];
---
{config.ads.enabled && id && (
  <aside class="ad" aria-label="Advertisement">
    <small>Advertisement</small>
    <ins class="adsbygoogle" style="display:block" data-ad-client={config.ads.client} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
